# Base URL of the FastAPI backend. Change this if the backend runs on a
# different host or port (Docker, Podman, remote server, etc.).
API_BASE_URL=http://localhost:8000

# Timeout in seconds for the /ask call.
ASK_TIMEOUT_SECONDS=90

# Timeout in seconds for /ready and /config.
STATUS_TIMEOUT_SECONDS=5
STREAM_RENDER_DELAY_SECONDS=0.006
