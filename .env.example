# Copy this file to .env. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=anyoneai-datasets
S3_PREFIX=queplan_insurance/

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ROUTER_MODEL=gpt-4.1-mini
# Current cost-sensitive model with Responses API web-search support.
OPENAI_WEB_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_EVALUATOR_MODEL=gpt-4.1-mini
WEB_SEARCH_CONTEXT_SIZE=medium

QDRANT_PATH=data/index/qdrant
QDRANT_COLLECTION=queplan_policies
RAG_TOP_K=5
# Keep blank: the 12-question evaluation found no safe global threshold.
RAG_SCORE_THRESHOLD=
