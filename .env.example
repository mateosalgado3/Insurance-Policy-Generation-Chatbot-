# Copy this file to .env. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=anyoneai-datasets
S3_PREFIX=queplan_insurance/

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

QDRANT_PATH=data/index/qdrant
QDRANT_COLLECTION=queplan_policies
RAG_TOP_K=5
# Keep blank: the 12-question evaluation found no safe global threshold.
RAG_SCORE_THRESHOLD=

# Used by the future web-news tool.
TAVILY_API_KEY=
